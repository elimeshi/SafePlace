{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/feedback/**",
              "components/forms/**",
              "components/surfaces/**",
              "ui_kits/mobile/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Rubik|Heebo))/i]",
        "message": "Font not provided by the design system. Available: Rubik, Heebo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|ring|ringColor|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, ring, ringColor, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|halo|block|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, halo, block, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|cta|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'cta' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|id|children|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, disabled, id, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GenderOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<GenderOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='InteractionBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:likes|comments|liked|saved|onLike|onComment|onShare|onSave|style|key|ref|className|style|children)$/]",
        "message": "<InteractionBar> doesn't accept that prop. Declared props: likes, comments, liked, saved, onLike, onComment, onShare, onSave, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostAuthor'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|avatar|key|ref|className|style|children)$/]",
        "message": "<PostAuthor> doesn't accept that prop. Declared props: name, avatar."
      },
      {
        "selector": "JSXOpeningElement[name.name='SourceLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|name|color|icon|style|key|ref|className|style|children)$/]",
        "message": "<SourceLabel> doesn't accept that prop. Declared props: kind, name, color, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SourceLabel'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:group|public|suggested)$/]",
        "message": "<SourceLabel> kind must be one of 'group' | 'public' | 'suggested'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SystemNotice'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|confirmLabel|cancelLabel|onConfirm|onCancel|style|key|ref|className|style|children)$/]",
        "message": "<SystemNotice> doesn't accept that prop. Declared props: tone, title, children, confirmLabel, cancelLabel, onConfirm, onCancel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SystemNotice'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|warning|danger)$/]",
        "message": "<SystemNotice> tone must be one of 'info' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|valid|error|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, onChange, valid, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|readOnly|disabled|label|description|id|style|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, onChange, readOnly, disabled, label, description, id, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
