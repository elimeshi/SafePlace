# Copy to .env.local (or apps/mobile/.env) and fill in real values.
# Never commit the real .env file — see .gitignore.

# Supabase (apps/mobile, packages/api-client)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Moderation pipeline (services/moderation-pipeline) — server-side only,
# never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=
VISION_MODEL_API_KEY=
VISION_MODEL_PROVIDER=
