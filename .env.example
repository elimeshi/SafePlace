# Copy to .env.local (or apps/mobile/.env) and fill in real values.
# Never commit the real .env file — see .gitignore.

# Supabase (apps/mobile, packages/api-client)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Moderation pipeline (services/moderation-pipeline) — server-side only,
# never exposed to the client. Nothing here may be given an EXPO_PUBLIC_
# prefix: that prefix ships the value inside the app bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# stub | anthropic. Defaults to stub. There is deliberately no silent fallback:
# setting anthropic without a key fails at startup rather than classifying
# everything with a stub while looking healthy.
VISION_MODEL_PROVIDER=stub
VISION_MODEL_API_KEY=

# Shared secret the scheduler presents to the worker endpoint. Without it the
# endpoint refuses to serve — an open drain endpoint is a free way for anyone
# to burn the vision-API budget.
MODERATION_WORKER_SECRET=

# Optional: identifies this worker in job locks and logs. Defaults to "worker".
MODERATION_WORKER_ID=

# NOTE: confidence thresholds and the model id are NOT environment variables.
# They live in moderation.pipeline_config so they can be retuned without a
# deploy (07-moderation-spec.md §2.1 defers the real values until there is
# performance data to set them from).
